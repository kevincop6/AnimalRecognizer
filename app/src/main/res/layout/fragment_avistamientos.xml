<?xml version="1.0" encoding="utf-8"?>
<!--
    CAMBIO ESTRUCTURAL: LinearLayout → FrameLayout como root.
    Con LinearLayout vertical el RecyclerView empieza DEBAJO del header,
    nunca puede verse a través de sus esquinas redondeadas.
    Con FrameLayout las vistas se apilan en capas:
    - Capa 1 (fondo): RecyclerView con paddingTop=56dp para que su
      contenido no quede oculto bajo el header, pero SÍ esté detrás de él.
    - Capa 2 (frente): Header encima del RecyclerView.
    Las esquinas redondeadas inferiores del bg_header_rounded revelan
    el contenido del RecyclerView que está exactamente detrás.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!--
        CAPA 1 — FEED (debajo del header).
        layout_height="match_parent": ocupa toda la pantalla incluyendo
        la zona detrás del header.
        paddingTop="57dp": 56dp (altura header) + 1dp (divider). El primer
        ítem visible arranca justo debajo del header, pero el RecyclerView
        físicamente SÍ llega hasta arriba del todo → es lo que se ve en
        las esquinas redondeadas del header.
        clipToPadding="false": permite que el scroll llegue detrás del header.
    -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFeed"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="57dp"
        android:paddingBottom="96dp" />

    <!--
        CAPA 2 — HEADER (encima del feed).
        FrameLayout transparente + outlineProvider="none":
        no pinta nada, solo contiene el ConstraintLayout.
        La sombra la emite el ConstraintLayout directamente.
    -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#00000000"
        android:outlineProvider="none">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingHorizontal="16dp"
            android:background="@drawable/bg_header_rounded"
            android:elevation="8dp"
            android:outlineProvider="bounds">

            <TextView
                android:id="@+id/tvAppName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="@font/bilbo"
                android:textColor="@color/text_primary"
                android:ellipsize="end"
                android:maxLines="1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnSearch"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintHorizontal_bias="0" />

            <ImageButton
                android:id="@+id/btnSearch"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:src="@drawable/ic_search"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/buscar"
                app:tint="@color/text_primary"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnnotification" />

            <ImageButton
                android:id="@+id/btnnotification"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:src="@drawable/ic_notifications_24dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/notificaci_n"
                app:tint="@color/text_primary"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>

</FrameLayout>

